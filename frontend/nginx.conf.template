server {
  listen 80;
  root /usr/share/nginx/html;
  index index.html;
  # El navegador solo habla con este servidor; Nginx reenvía /api a la IP PRIVADA del backend
  location /api/ { proxy_pass http://${BACKEND_HOST}:8080; proxy_set_header Host $host; }
  location / { try_files $uri $uri/ /index.html; }
}
